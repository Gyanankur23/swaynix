# ============================================
# Swaynix - Required Environment Variables
# ============================================

# Database (Required)
DATABASE_URL=postgresql://username:password@localhost:5432/swaynix

# Application (Required)
NEXT_PUBLIC_API_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000
PORT=3001

# Security (Required)
JWT_SECRET=change-this-to-a-random-string-in-production
SESSION_SECRET=change-this-to-a-random-string-in-production

# ============================================
# Firebase Auth (Required for Google OAuth)
# Get from: Firebase Console > Project Settings > General > Your apps
# ============================================

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin (Server-side auth verification)
FIREBASE_ADMIN_SDK_KEY={"type":"service_account","project_id":"..."}

# ============================================
# Optional Services (Uncomment if needed)
# ============================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
